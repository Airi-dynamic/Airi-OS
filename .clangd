CompileFlags:
  Add:
    - --target=x86_64-unknown-none-elf
    - -I/Users/airi/Desktop/Airi-OS/include
    - -I/Users/airi/Desktop/Airi-OS/kernel
    - -I/Users/airi/Desktop/Airi-OS/third_party
    - -I/Users/airi/Desktop/Airi-OS
    - -D__KERNEL__

---
If:
  PathMatch: .*\.(c|h)$
CompileFlags:
  Add:
    - -xc
    - -std=c17
